# GitHub token for the live GitHub data. Without it the site uses lib/github-snapshot.json.
GITHUB_TOKEN=
# Resend API key for the contact form.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=
# Optional sender address for contact emails. Defaults to Portfolio <onboarding@resend.dev>.
CONTACT_FROM_EMAIL=
# Optional Anthropic API key. When set, the Ask my agent panel and buttons appear.
ANTHROPIC_API_KEY=
